{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/candidate-moment-evidence-v1.schema.json",
  "title": "Clippers Candidate Moment Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "source_id", "start_ms", "end_ms", "status", "title", "why_now", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^candidate_[a-z0-9][a-z0-9_-]*$"},
    "source_id": {"type": "string", "minLength": 1},
    "start_ms": {"type": "integer", "minimum": 0},
    "end_ms": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "eligible", "excluded"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "why_now": {"type": "string", "minLength": 12},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "artifact", "start_ms", "end_ms", "observation"],
        "properties": {
          "kind": {"enum": ["transcript", "media", "visual", "audio", "metadata"]},
          "artifact": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "observation": {"type": "string", "minLength": 3},
          "verbatim": {"type": ["string", "null"]}
        }
      }
    }
  }
}
