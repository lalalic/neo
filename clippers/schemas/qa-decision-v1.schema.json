{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/qa-decision-v1.schema.json",
  "title": "Clippers QA Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qa_id", "source_id", "reviewer", "independent", "decision", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "qa_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "decision": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
