{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/qa-decisions-v1.schema.json",
  "title": "Clippers QA Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "selection_id", "reviewer", "independent", "decision", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "minLength": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "decision": {"enum": ["pass", "fail"]},
    "decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["qa_id", "variant_id", "candidate_id", "decision", "checks"],
        "properties": {
          "qa_id": {"type": "string", "minLength": 1},
          "variant_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["pass", "fail"]},
          "checks": {
            "type": "array", "minItems": 5,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "result", "evidence"],
              "properties": {"id": {"type": "string", "minLength": 1}, "result": {"enum": ["pass", "fail", "not_applicable"]}, "evidence": {"type": "string", "minLength": 1}}
            }
          },
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
