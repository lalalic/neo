{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/run-state-v2.schema.json",
  "title": "Clippers Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_id", "state", "artifacts", "history"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["initiated", "source_authorized", "media_preflight", "transcript_extracted", "text_candidates_extracted", "vision_reviewed", "judge_ranked", "variants_planned", "qa_failed", "qa_passed", "markcut_ready", "publication_authorized", "published", "metrics_24h", "metrics_72h", "metrics_7d", "learning_recorded", "blocked", "failed"]},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization"],
      "properties": {
        "authorization": {"type": "string"}, "research": {"type": "string"}, "media": {"type": "string"}, "transcript": {"type": "string"}, "text_candidates": {"type": "string"}, "vision_reviews": {"type": "string"}, "campaign_brief": {"type": "string"}, "judge": {"type": "string"}, "selection": {"type": "string"}, "variants": {"type": "string"}, "qa": {"type": "string"}, "markcut": {"type": "string"}, "publication_authorization": {"type": "string"}, "publication_record": {"type": "string"}, "metrics_24h": {"type": "string"}, "metrics_72h": {"type": "string"}, "metrics_7d": {"type": "string"}, "learning": {"type": "string"}
      }
    },
    "blocked_reason": {"type": ["string", "null"]},
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "at", "actor"],
        "properties": {"state": {"type": "string", "minLength": 1}, "at": {"type": "string", "format": "date-time"}, "actor": {"type": "string", "minLength": 1}, "artifact": {"type": "string"}}
      }
    }
  }
}
