{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/ranked-selection-v2.schema.json",
  "title": "Clippers Ranked Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "source_id", "platform", "rubric_id", "rubric_version", "judge_artifact", "rankings"],
  "properties": {
    "schema_version": {"const": 2},
    "selection_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "rubric_id": {"const": "clippers-rubric-v1"},
    "rubric_version": {"const": 2},
    "judge_artifact": {"type": "string", "minLength": 1},
    "rankings": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "candidate_id", "judge_entry_id", "vision_artifact", "status", "weighted_score"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 10},
          "candidate_id": {"type": "string", "minLength": 1},
          "judge_entry_id": {"type": "string", "minLength": 1},
          "vision_artifact": {"type": "string", "minLength": 1},
          "status": {"const": "eligible"},
          "weighted_score": {"type": "number", "minimum": 0, "maximum": 2}
        }
      }
    }
  }
}
