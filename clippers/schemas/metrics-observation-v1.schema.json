{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/metrics-observation-v1.schema.json",
  "title": "Clippers Metrics Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "source_id", "selection_id", "variant_id", "publication_artifact", "window", "captured_at", "metrics", "interpretation"],
  "properties": {
    "schema_version": {"const": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "publication_artifact": {"type": "string", "minLength": 1},
    "window": {"enum": ["24h", "72h", "7d"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["views", "watch_time_seconds", "retention_rate", "completion_rate"],
      "properties": {
        "views": {"type": "integer", "minimum": 0},
        "watch_time_seconds": {"type": "number", "minimum": 0},
        "retention_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "completion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "likes": {"type": "integer", "minimum": 0},
        "comments": {"type": "integer", "minimum": 0},
        "shares": {"type": "integer", "minimum": 0},
        "revenue_amount": {"type": ["number", "null"], "minimum": 0},
        "revenue_currency": {"type": ["string", "null"], "minLength": 3}
      }
    },
    "interpretation": {"type": "string", "minLength": 12}
  }
}
