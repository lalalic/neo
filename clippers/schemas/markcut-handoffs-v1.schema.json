{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/markcut-handoffs-v1.schema.json",
  "title": "Clippers Markcut Handoffs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "selection_id", "input_media", "handoffs"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "minLength": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "input_media": {"type": "string", "minLength": 1},
    "handoffs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variant_id", "candidate_id", "qa_id", "target_platform", "source_interval", "hook_strategy", "edit_directives", "deliverable", "evidence_artifacts"],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "qa_id": {"type": "string", "minLength": 1},
          "target_platform": {"type": "string", "minLength": 1},
          "source_interval": {"type": "object", "additionalProperties": false, "required": ["start_ms", "end_ms"], "properties": {"start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}}},
          "hook_strategy": {"type": "string", "minLength": 12},
          "edit_directives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "deliverable": {"type": "string", "minLength": 1},
          "evidence_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
