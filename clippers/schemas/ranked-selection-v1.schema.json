{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clippers/schemas/ranked-selection-v1.schema.json",
  "title": "Clippers Ranked Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_id", "source_id", "rubric_id", "rubric_version", "rankings"],
  "properties": {
    "schema_version": {"const": 1},
    "selection_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "rubric_id": {"const": "clippers-rubric-v1"},
    "rubric_version": {"const": 1},
    "rankings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "candidate_id", "candidate_artifact", "status", "scores", "weighted_score"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "candidate_artifact": {"type": "string", "minLength": 1},
          "status": {"const": "eligible"},
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hook_first_two_seconds", "narrative_payoff", "attention_intensity", "visual_audio_support", "platform_fit", "accessibility"],
            "properties": {
              "hook_first_two_seconds": {"type": "number", "minimum": 0, "maximum": 2},
              "narrative_payoff": {"type": "number", "minimum": 0, "maximum": 2},
              "attention_intensity": {"type": "number", "minimum": 0, "maximum": 2},
              "visual_audio_support": {"type": "number", "minimum": 0, "maximum": 2},
              "platform_fit": {"type": "number", "minimum": 0, "maximum": 2},
              "accessibility": {"type": "number", "minimum": 0, "maximum": 2}
            }
          },
          "weighted_score": {"type": "number", "minimum": 0, "maximum": 2},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
