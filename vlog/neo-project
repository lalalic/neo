#!/usr/bin/env bash
set -euo pipefail

# Neo Project Lifecycle Contract: PM2 runs the canonical project scripts/lib directly.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE="vlog/watcher"
ENTRYPOINT="$ROOT/scripts/vlog-inbox-watcher.mjs"
INBOX="${VLOG_ICLOUD_INBOX:-$HOME/Library/Mobile Documents/iCloud~com~neox~app/Documents/Vlog Inbox}"
export VLOG_ICLOUD_INBOX="$INBOX"
export VLOG_RUNS_DIR="${VLOG_RUNS_DIR:-$ROOT/runs}"

usage() {
  printf '%s\n' 'usage: ./neo-project {setup|start|stop|restart|status|health|uninstall|help}'
}

pm2() { npx --yes pm2 "$@"; }

# Node is only used to parse documented PM2 process metadata, not to run a second service.
process_record() {
  pm2 jlist | node -e '
    let raw = "";
    process.stdin.on("data", part => raw += part);
    process.stdin.on("end", () => {
      const item = JSON.parse(raw).find(p => p.name === "vlog/watcher");
      console.log(JSON.stringify(item ? {
        exists: true,
        status: item.pm2_env?.status,
        pid: item.pid,
        entrypoint: item.pm2_env?.pm_exec_path,
        cwd: item.pm2_env?.pm_cwd
      } : { exists: false }));
    });'
}

exists() { [ "$(process_record | node -p 'JSON.parse(require("fs").readFileSync(0,"utf8")).exists')" = 'true' ]; }
current() {
  process_record | node -e '
    let raw="";
    process.stdin.on("data", c => raw += c);
    process.stdin.on("end", () => {
      const item = JSON.parse(raw);
      process.exit(item.exists && item.entrypoint === process.argv[1] && item.cwd === process.argv[2] ? 0 : 1);
    });' "$ENTRYPOINT" "$ROOT"
}

status() {
  process_record | node -e '
    let raw="";
    process.stdin.on("data", c => raw += c);
    process.stdin.on("end", () => {
      const record = JSON.parse(raw);
      const installed = record.exists === true;
      const online = installed && record.status === "online" && Number(record.pid) > 0;
      console.log(JSON.stringify({
        project: "vlog", service: "watcher",
        status: installed ? record.status : "not-installed",
        running: online, pid: online ? record.pid : null,
        entrypoint: installed ? record.entrypoint : null,
        source: !installed ? "none" : record.entrypoint === process.argv[1] && record.cwd === process.argv[2] ? "project-scripts" : "legacy-or-other",
      }));
    });' "$ENTRYPOINT" "$ROOT"
}

setup() {
  command -v node >/dev/null
  command -v npx >/dev/null
  test -f "$ENTRYPOINT"
  test -f "$ROOT/lib/inbox-watcher.mjs"
  node --check "$ENTRYPOINT"
  node --check "$ROOT/lib/inbox-watcher.mjs"
  pm2 --version >/dev/null
  mkdir -p "$VLOG_RUNS_DIR"
  printf '%s\n' 'Vlog watcher source verified; no package/install or duplicated runtime.'
}

install_direct() {
  (cd "$ROOT" && pm2 start "$ENTRYPOINT" --name "$SERVICE" --cwd "$ROOT" --interpreter "$(command -v node)" >/dev/null)
}

start() {
  setup >/dev/null
  if exists; then
    if current; then
      if [ "$(pm2 pid "$SERVICE" | tail -1 | tr -d '[:space:]')" != '0' ]; then
        status
        return
      fi
      pm2 restart "$SERVICE" --update-env >/dev/null
    else
      # One-time migration from a stale packaged or alternate entrypoint.
      pm2 delete "$SERVICE" >/dev/null
      install_direct
    fi
  else
    install_direct
  fi
  pm2 save >/dev/null
  health >/dev/null
  status
}

stop() {
  if exists; then pm2 stop "$SERVICE" >/dev/null; pm2 save >/dev/null; fi
  status
}

health() {
  node -e '
    const fs = require("node:fs");
    try {
      fs.readdirSync(process.env.VLOG_ICLOUD_INBOX);
      fs.accessSync(process.env.VLOG_RUNS_DIR, fs.constants.R_OK | fs.constants.W_OK);
      fs.accessSync(process.argv[1], fs.constants.R_OK);
      console.log(JSON.stringify({project:"vlog", inboxReadable:true, runsWritable:true, sourceReadable:true}));
    } catch (error) {
      console.error(JSON.stringify({project:"vlog", healthy:false, reason:error.code ?? error.message}));
      process.exitCode = 1;
    }' "$ENTRYPOINT"
  if ! exists || ! current || [ "$(pm2 pid "$SERVICE" | tail -1 | tr -d '[:space:]')" = '0' ]; then
    printf '%s\n' '{"project":"vlog","healthy":false,"reason":"watcher not running from canonical project scripts"}' >&2
    return 1
  fi
  printf '%s\n' '{"project":"vlog","healthy":true,"source":"project-scripts"}'
}

case "${1:-help}" in
  setup) setup ;;
  start) start ;;
  stop) stop ;;
  restart)
    setup >/dev/null
    if exists && current; then
      pm2 restart "$SERVICE" --update-env >/dev/null
      pm2 save >/dev/null
      health >/dev/null
      status
    else
      start
    fi
    ;;
  status) status ;;
  health) health ;;
  uninstall)
    if exists; then pm2 delete "$SERVICE" >/dev/null; pm2 save >/dev/null; fi
    printf '%s\n' 'Vlog watcher removed; project source, user media and runs preserved.'
    ;;
  help|--help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
