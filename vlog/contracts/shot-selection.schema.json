{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vlog Director shot selection",
  "type": "object",
  "required": [
    "schema_version",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "source_hash",
          "beat",
          "evidence_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "candidate_start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "candidate_end_seconds": {
            "type": "number",
            "minimum": 0
          },
          "still_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "recipe": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "candidate_start_seconds",
              "candidate_end_seconds"
            ]
          },
          {
            "required": [
              "still_duration_seconds"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
