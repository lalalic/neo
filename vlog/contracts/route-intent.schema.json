{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "decision", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "decision": {"enum": ["include", "omit"]},
    "reason": {"type": "string", "minLength": 1},
    "insertAfterStoryBeatId": {"type": "string", "minLength": 1},
    "narration": {"type": "string", "minLength": 1},
    "observedStops": {"type": "array", "items": {"type": "object", "required": ["sourceId", "evidenceRef"], "properties": {"sourceId": {"type": "string", "minLength": 1}, "evidenceRef": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "audienceContext": {"type": "array", "items": {"type": "object", "required": ["fact", "sourceRef"], "properties": {"fact": {"type": "string", "minLength": 2}, "sourceRef": {"type": "string", "minLength": 2}, "whyRelevant": {"type": "string", "minLength": 2}}, "additionalProperties": true}}
  },
  "allOf": [{"if": {"properties": {"decision": {"const": "include"}}}, "then": {"required": ["insertAfterStoryBeatId", "narration", "observedStops"], "properties": {"observedStops": {"minItems": 1}}}}],
  "additionalProperties": true
}
