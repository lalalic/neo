{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "reason", "user_action", "evidence", "notification"],
  "properties": {
    "status": { "enum": ["resolved", "needs_user", "failed"] },
    "summary": { "type": "string" },
    "reason": { "type": ["string", "null"] },
    "user_action": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attempted", "delivered", "channel", "details"],
      "properties": {
        "attempted": { "type": "boolean" },
        "delivered": { "type": ["boolean", "null"] },
        "channel": { "type": ["string", "null"] },
        "details": { "type": ["string", "null"] }
      }
    }
  }
}
