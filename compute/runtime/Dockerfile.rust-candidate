# Linux static runtime is built inside an isolated musl toolchain stage.
ARG NEO_BASE_IMAGE
FROM --platform=linux/amd64 rust:1.99-alpine AS neo-runtime-build
RUN apk add --no-cache build-base binutils
WORKDIR /build
COPY --from=neo-runtime /Cargo.toml /Cargo.lock ./
COPY --from=neo-runtime /src ./src
RUN RUSTFLAGS="-C target-feature=+crt-static" cargo build --locked --release --target x86_64-unknown-linux-musl \
    && readelf -h target/x86_64-unknown-linux-musl/release/neo-compute-runtime | grep -q 'X86-64' \
    && ! readelf -l target/x86_64-unknown-linux-musl/release/neo-compute-runtime | grep -q INTERP \
    && ! readelf -d target/x86_64-unknown-linux-musl/release/neo-compute-runtime | grep -q NEEDED
FROM ${NEO_BASE_IMAGE}
ARG NEO_GPU_CMD_JSON
ARG NEO_GPU_MODE=batch
ARG NEO_GPU_APP_PORT=7860
ARG NEO_GPU_SERVICE_NAME=app
ENV NEO_GPU_CMD_JSON=${NEO_GPU_CMD_JSON} \
    NEO_GPU_MODE=${NEO_GPU_MODE} \
    NEO_GPU_APP_PORT=${NEO_GPU_APP_PORT} \
    NEO_GPU_BASE_PATH=/${NEO_GPU_SERVICE_NAME}/ \
    NEO_GPU_PORT=8000 \
    NEO_GPU_INPUT_DIR=/neo/input \
    NEO_GPU_OUTPUT_DIR=/neo/output
COPY --from=neo-runtime-build /build/target/x86_64-unknown-linux-musl/release/neo-compute-runtime /opt/neo-gpu/neo-compute-runtime
EXPOSE 8000
ENTRYPOINT ["/opt/neo-gpu/neo-compute-runtime"]
