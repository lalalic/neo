# Generic Neo GPU service wrapper. Input Dockerfile defines app dependencies and
# CMD/ENTRYPOINT; this layer injects the shared Node.js execution contract.
ARG NEO_BASE_IMAGE
FROM node:22-bookworm-slim AS neo-node
FROM ${NEO_BASE_IMAGE}
ARG NEO_GPU_CMD_JSON
ENV NEO_GPU_CMD_JSON=${NEO_GPU_CMD_JSON} \
    NEO_GPU_PORT=8000 \
    NEO_GPU_INPUT_DIR=/neo/input \
    NEO_GPU_OUTPUT_DIR=/neo/output
COPY --from=neo-node /usr/local/bin/node /opt/neo-gpu/node
# Detect glibc incompatibility at image build rather than after renting a GPU.
RUN /opt/neo-gpu/node --version
COPY --from=neo-runtime /service.mjs /opt/neo-gpu/service.mjs
EXPOSE 8000
ENTRYPOINT ["/opt/neo-gpu/node", "/opt/neo-gpu/service.mjs"]
