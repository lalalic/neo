{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/demo-agent-v1.schema.json",
  "title": "Neo Demo Agent Runtime Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shot", "runtime"],
  "properties": {
    "schema_version": {"const": 1},
    "shot": {"type": "object", "required": ["id", "identity", "intent", "required_visible_evidence", "success", "presentation", "autonomy"]},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_tools", "capture_scope", "recording_required"],
      "properties": {
        "allowed_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capture_scope": {"type": "string", "enum": ["shot", "full_flow"]},
        "recording_required": {"type": "boolean"}
      }
    }
  }
}
