{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/video-director-input-v1.schema.json",
  "title": "Neo Video Director Authoring Input",
  "type": "object",
  "required": [
    "schema_version",
    "brief",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "brief": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "minItems": 1
    }
  }
}
