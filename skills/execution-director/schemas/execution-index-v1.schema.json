{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/execution-index-v1.schema.json",
  "title": "Execution Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "scene_id",
          "status",
          "output"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "demo",
              "capture",
              "image",
              "video"
            ]
          },
          "scene_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "blocked"
            ]
          },
          "output": {
            "type": "string"
          }
        }
      }
    }
  }
}
