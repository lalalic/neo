{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo.local/schemas/execution-director-v1.schema.json",
  "title": "Neo Execution Director Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_scene_id", "shots"],
  "properties": {
    "schema_version": {"const": 1},
    "source_scene_id": {"type": "string", "minLength": 1},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "identity", "intent", "required_visible_evidence", "success", "presentation", "autonomy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "identity": {
            "type": "object", "additionalProperties": false,
            "required": ["product", "surface", "feature"],
            "properties": {
              "product": {"type": "string", "minLength": 1},
              "surface": {"type": "string", "minLength": 1},
              "feature": {"type": "string", "minLength": 1}
            }
          },
          "intent": {
            "type": "object", "additionalProperties": false,
            "required": ["purpose", "communicates"],
            "properties": {"purpose": {"type": "string", "minLength": 1}, "communicates": {"type": "string", "minLength": 1}}
          },
          "required_visible_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "success": {
            "type": "object", "additionalProperties": false,
            "required": ["fresh_ui_required", "visible_state"],
            "properties": {"fresh_ui_required": {"const": true}, "visible_state": {"type": "string", "minLength": 1}}
          },
          "presentation": {
            "type": "object", "additionalProperties": false,
            "required": ["focus", "highlight", "text", "zoom", "duration_seconds"],
            "properties": {
              "focus": {"type": "string", "minLength": 1},
              "highlight": {"type": "array", "items": {"type": "string"}},
              "text": {"type": "array", "items": {"type": "string"}},
              "zoom": {"type": "string", "enum": ["none", "subtle", "emphasis"]},
              "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "autonomy": {
            "type": "object", "additionalProperties": false,
            "required": ["allowed_recovery", "boundary"],
            "properties": {
              "allowed_recovery": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "boundary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
