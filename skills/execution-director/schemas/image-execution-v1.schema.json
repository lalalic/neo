{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Execution Lane v1",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "scene_id",
          "output",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "const": "image"
          },
          "scene_id": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        }
      }
    }
  }
}
