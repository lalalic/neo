#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re

import yaml
from pathlib import Path

HOME = Path.home()
ROOTS = [
    HOME / ".agents" / "skills",
    HOME / "Workspace" / "neo" / "skills",
    HOME / "Workspace",
]
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "dist", "build", ".next", "target", "vendor"}


def candidate_files() -> list[Path]:
    found: dict[str, Path] = {}

    # Canonical agent/Neo registries: direct skill children.
    for root in ROOTS[:2]:
        if root.is_dir():
            for p in root.glob("*/SKILL.md"):
                try:
                    found[str(p.resolve())] = p.resolve()
                except OSError:
                    pass

    # Project-owned skills: */skills/*/SKILL.md, including projects nested under neo.
    workspace = ROOTS[2]
    if workspace.is_dir():
        for dirpath, dirnames, filenames in os.walk(workspace):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
            pdir = Path(dirpath)
            if "SKILL.md" not in filenames:
                continue
            # Only treat files whose parent is a child of a directory named `skills` as skills.
            if pdir.parent.name != "skills":
                continue
            p = pdir / "SKILL.md"
            try:
                found[str(p.resolve())] = p.resolve()
            except OSError:
                pass

    return sorted(found.values(), key=lambda p: str(p).lower())


def parse_frontmatter(path: Path) -> dict[str, str] | None:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    try:
        front = yaml.safe_load(text[4:end]) or {}
    except yaml.YAMLError:
        return None
    if not isinstance(front, dict):
        return None
    name = str(front.get("name") or path.parent.name).strip()
    description = str(front.get("description") or "").strip()
    if not description:
        return None
    return {"name": name, "description": description, "path": str(path)}


def main() -> int:
    ap = argparse.ArgumentParser(description="Discover local skills usable by XChat orchestrators.")
    ap.add_argument("--markdown", action="store_true", help="output a compact Markdown table instead of JSON")
    args = ap.parse_args()

    parsed = [s for p in candidate_files() if (s := parse_frontmatter(p))]

    # One active entry per skill name. Prefer Neo-owned skills, then project-owned
    # workspace skills, then the generic ~/.agents installation.
    def priority(skill: dict[str, str]) -> tuple[int, str]:
        path = skill["path"]
        neo = str(HOME / "Workspace" / "neo" / "skills") + "/"
        workspace = str(HOME / "Workspace") + "/"
        agents = str(HOME / ".agents" / "skills") + "/"
        if path.startswith(neo):
            rank = 0
        elif path.startswith(workspace):
            rank = 1
        elif path.startswith(agents):
            rank = 2
        else:
            rank = 3
        return (rank, path.lower())

    chosen: dict[str, dict[str, str]] = {}
    for skill in sorted(parsed, key=priority):
        chosen.setdefault(skill["name"].lower(), skill)
    skills = sorted(chosen.values(), key=lambda s: s["name"].lower())

    if args.markdown:
        print("| Name | Description | Absolute path |")
        print("|---|---|---|")
        for s in skills:
            desc = s["description"].replace("|", "\\|")
            print(f"| `{s['name']}` | {desc} | `{s['path']}` |")
    else:
        print(json.dumps(skills, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
