#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import re

try:
    import yaml
except ImportError:  # Portable npm CLI must not require user-site PyYAML.
    yaml = None
from pathlib import Path
from workspace_config import load_workspace_config

HOME = Path.home()
GLOBAL_SKILLS = HOME / ".agents" / "skills"
NEO_SKILLS = Path(load_workspace_config()["neoRoot"]) / "skills"
ROOTS = [GLOBAL_SKILLS, NEO_SKILLS]

def candidate_files(project_root: Path | None = None) -> list[Path]:
    found: dict[str, Path] = {}

    # Canonical agent/Neo registries: direct skill children.
    for root in ROOTS:
        if root.is_dir():
            for p in root.glob("*/SKILL.md"):
                try:
                    found[str(p.resolve())] = p
                except OSError:
                    pass

    # Project-owned skills. With an active project binding, only that project's
    # local skills are visible. The three canonical layers are ~/.agents, Neo,
    # and the bound project; unrelated Workspace projects are never imported.
    if project_root is not None:
        local_skills = project_root / "skills"
        if local_skills.is_dir():
            for p in local_skills.glob("*/SKILL.md"):
                try:
                    found[str(p.resolve())] = p
                except OSError:
                    pass

    return sorted(found.values(), key=lambda p: str(p).lower())


def parse_frontmatter_subset(source: str) -> dict[str, object] | None:
    """Portable, deliberately narrow YAML subset for skill name/description/requires.skills.

    Unsupported dependency syntax is rejected, not silently declared resolved.
    """
    values: dict[str, object] = {}
    lines = source.splitlines()
    index = 0
    while index < len(lines):
        line = lines[index]
        if not line.strip() or line.lstrip().startswith("#"):
            index += 1
            continue
        match = re.match(r"^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$", line)
        if not match:
            return None
        key, value = match.groups()
        if key in ("name", "description"):
            if value in ("|", "|-", ">", ">-"):
                parts = []
                index += 1
                while index < len(lines) and (lines[index].startswith(" ") or not lines[index].strip()):
                    if lines[index].strip():
                        parts.append(lines[index].strip())
                    index += 1
                values[key] = " ".join(parts) if value.startswith(">") else "\n".join(parts)
                continue
            if value.startswith("'") and value.endswith("'"):
                values[key] = value[1:-1].replace("''", "'")
            elif value.startswith('"') and value.endswith('"'):
                values[key] = value[1:-1]
            else:
                values[key] = value
        elif key == "requires":
            if value:
                return None
            skills = []
            index += 1
            if index >= len(lines) or not re.match(r"^  skills:\s*$", lines[index]):
                return None
            index += 1
            while index < len(lines) and lines[index].startswith("    - "):
                item = lines[index][6:].strip().strip('\"\'')
                if not item:
                    return None
                skills.append(item)
                index += 1
            if index < len(lines) and lines[index].startswith(" ") and lines[index].strip():
                return None
            values["requires"] = {"skills": skills}
            continue
        else:
            # Ignore unrelated well-indented metadata/licensing sections.
            index += 1
            while index < len(lines) and (lines[index].startswith(" ") or not lines[index].strip()):
                index += 1
            continue
        index += 1
    return values


def parse_frontmatter(path: Path) -> dict[str, object] | None:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    if yaml is None:
        front = parse_frontmatter_subset(text[4:end])
    else:
        try:
            front = yaml.safe_load(text[4:end]) or {}
        except yaml.YAMLError:
            return None
    if not isinstance(front, dict):
        return None
    name = str(front.get("name") or path.parent.name).strip()
    description = str(front.get("description") or "").strip()
    if not description:
        return None
    requires = front.get("requires")
    required_skills: list[str] = []
    if isinstance(requires, dict):
        raw_skills = requires.get("skills")
        if isinstance(raw_skills, list):
            required_skills = [skill.strip() for skill in raw_skills if isinstance(skill, str) and skill.strip()]
    result: dict[str, object] = {"name": name, "description": description, "path": str(path)}
    if isinstance(requires, dict) and isinstance(requires.get("skills"), list):
        result["requires"] = {"skills": required_skills}
    return result


def main() -> int:
    ap = argparse.ArgumentParser(description="Discover local skills usable by XChat orchestrators.")
    ap.add_argument("--markdown", action="store_true", help="output a compact Markdown table instead of JSON")
    ap.add_argument("--project", help="active project root; project-local skills override same-named global skills")
    args = ap.parse_args()

    project_root = None
    if args.project:
        try:
            project_root = Path(args.project).expanduser().resolve()
        except OSError:
            project_root = Path(args.project).expanduser()

    parsed = [s for p in candidate_files(project_root) if (s := parse_frontmatter(p))]

    # One active entry per skill name. The active project gets first priority,
    # then Neo-global skills, then ~/.agents.
    def priority(skill: dict[str, str]) -> tuple[int, str]:
        path = skill["path"]
        neo = str(NEO_SKILLS) + "/"
        agents = str(HOME / ".agents" / "skills") + "/"
        project_skills = (str(project_root / "skills") + "/") if project_root else None
        if project_skills and path.startswith(project_skills):
            rank = 0
        elif path.startswith(neo):
            rank = 1
        elif path.startswith(agents):
            rank = 2
        else:
            rank = 3
        return (rank, path.lower())

    chosen: dict[str, dict[str, object]] = {}
    for skill in sorted(parsed, key=priority):
        chosen.setdefault(skill["name"].lower(), skill)

    for skill in chosen.values():
        requires = skill.get("requires")
        if not isinstance(requires, dict):
            continue
        required_skills = requires.get("skills", [])
        missing = [name for name in required_skills if name.lower() not in chosen]
        skill["requires_resolved"] = not missing
        skill["missing_required_skills"] = missing

    skills = sorted(chosen.values(), key=lambda s: str(s["name"]).lower())

    if args.markdown:
        print("| Name | Description | Requires | Dependencies | Absolute path |")
        print("|---|---|---|---|---|")
        for s in skills:
            desc = str(s["description"]).replace("|", "\\|")
            requires = s.get("requires", {})
            required = requires.get("skills", []) if isinstance(requires, dict) else []
            dependency_text = ""
            if "requires_resolved" in s:
                dependency_text = "resolved" if s["requires_resolved"] else "missing: " + ", ".join(s["missing_required_skills"])
            print(f"| `{s['name']}` | {desc} | {', '.join(required)} | {dependency_text} | `{s['path']}` |")
    else:
        print(json.dumps(skills, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
