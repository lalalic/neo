#!/usr/bin/env python3
"""Discover independently versioned Neo Projects directly under NEO_ROOT.

A project belongs to its own .git, not a nested folder tracked by the Harness
source repository. No legacy monorepo or Workspace-relative fallback exists.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
from pathlib import Path
from workspace_config import load_workspace_config

SETTINGS = load_workspace_config()
PROJECTS_ROOT = Path(SETTINGS["neoRoot"])
NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def git_root(path: Path) -> Path | None:
    try:
        value = subprocess.check_output(
            ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
        return Path(value).resolve()
    except (subprocess.CalledProcessError, OSError):
        return None


def origin_repo(path: Path) -> tuple[str, str | None]:
    try:
        origin = subprocess.check_output(
            ["git", "-C", str(path), "remote", "get-url", "origin"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
    except (subprocess.CalledProcessError, OSError):
        return f"local/{path.name}", None
    github = re.fullmatch(
        r"(?:git@github\.com:|ssh://git@github\.com/|https?://github\.com/)"
        r"([^/]+/[^/]+?)(?:\.git)?/?", origin,
    )
    return (github.group(1) if github else f"local/{path.name}"), origin


def projects() -> list[dict[str, object]]:
    root = PROJECTS_ROOT.resolve()
    if not root.is_dir():
        return []
    rows = []
    for path in sorted(root.iterdir(), key=lambda item: item.name.casefold()):
        if (not NAME_PATTERN.fullmatch(path.name) or path.is_symlink() or
            not path.is_dir() or not (path / ".git").exists() or
            git_root(path) != path.resolve()):
            continue
        if (not (path / "AGENTS.md").is_file() or
            not (path / "README.md").is_file() or
            not (path / "graph.mmd").is_file()):
            continue
        repository, origin = origin_repo(path)
        # Directory instruction inheritance is bounded at the selected root.
        # In particular, never use an unrelated Workspace or source checkout as
        # an implicit project repository or project definition.
        contexts = []
        global_rules = Path.home() / ".agents" / "AGENTS.md"
        if global_rules.is_file():
            contexts.append(str(global_rules))
        shared_rules = root / "AGENTS.md"
        if shared_rules.is_file():
            contexts.append(str(shared_rules))
        contexts.extend([str(path / "AGENTS.md"), str(path / "README.md")])
        rows.append({
            "xchat_project": path.name, "name": path.name,
            "local_path": str(path.resolve()), "git_root": str(path.resolve()),
            "repo": repository, "origin": origin, "neo_project": True,
            "context_files": contexts,
        })
    return rows


def with_project_capabilities(row: dict[str, object]) -> dict[str, object]:
    path = Path(str(row["local_path"]))
    result = dict(row)
    bootstrap = path / "setup" / "bootstrap.md"
    if bootstrap.is_file() and bootstrap.stat().st_size > 0:
        result["setup"] = {"bootstrap": str(bootstrap)}
    lifecycle = path / "neo-project"
    if lifecycle.is_file() and os.access(lifecycle, os.X_OK):
        result["lifecycle"] = {"entrypoint": str(lifecycle)}
    return result


def resolve(rows: list[dict[str, object]], query: str) -> dict[str, object]:
    name = query.strip()
    if not NAME_PATTERN.fullmatch(name):
        raise SystemExit(f"invalid Neo Project name: {query!r}; use a direct NEO_ROOT child name")
    matches = [row for row in rows if str(row["name"]).casefold() == name.casefold()]
    if len(matches) != 1:
        raise SystemExit(f"Neo Project not found in NEO_ROOT: {query}")
    return with_project_capabilities(matches[0])


def main() -> int:
    ap = argparse.ArgumentParser(description="Discover independent Git Neo Projects directly under NEO_ROOT")
    ap.add_argument("--resolve", metavar="PROJECT", help="resolve one direct child project by name")
    ap.add_argument("--markdown", action="store_true", help="print a project inventory table")
    args = ap.parse_args()
    rows = projects()
    if args.resolve:
        print(json.dumps(resolve(rows, args.resolve), ensure_ascii=False, indent=2))
    elif args.markdown:
        print("| Neo Project | Local path | Repository | Context |")
        print("|---|---|---|---|")
        for row in rows:
            context = ", ".join(Path(x).name for x in row["context_files"])
            print(f"| `{row['xchat_project']}` | `{row['local_path']}` | `{row['repo']}` | {context} |")
    else:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
