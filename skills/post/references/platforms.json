{
  "version": 1,
  "source": "migrated browser-harness adapters plus verified local implementation behavior",
  "platforms": {
    "xhs": {
      "display_name": "Xiaohongshu",
      "aliases": ["xiaohongshu"],
      "media": {
        "modes": ["video", "images"],
        "video": {"required_when_mode": "video", "formats": ["mp4"]},
        "images": {"required_when_mode": "images", "formats": ["jpg", "png", "webp"], "max_count": 18},
        "mutually_exclusive": ["video", "images"]
      },
      "fields": {
        "title": {"cli": "--title", "required": true, "type": "string", "max_chars": 20, "implemented": true},
        "body": {"cli": "--body", "required": true, "type": "string", "max_chars": 1000, "implemented": true},
        "tags": {"cli": "--tags", "required": false, "type": "string_list", "max_count": 5, "implemented": true, "render": "append as #tag"},
        "publish": {"cli": "--publish", "required": false, "type": "boolean", "default": false, "implemented": true}
      },
      "capabilities": {
        "draft": true,
        "publish": true,
        "visibility": false,
        "custom_thumbnail": false,
        "series_or_collection": false,
        "post_status": true,
        "read_comments": true,
        "write_comment": true,
        "reply_comments": true
      },
      "content_mapping": {
        "headline": "title",
        "main_text": "body",
        "discovery_terms": "tags"
      },
      "notes": [
        "Without --publish, the adapter saves a draft.",
        "After --publish, the XHS adapter automatically verifies the created note in creator note manager and reports published/reviewing/rejected state.",
        "comments/comment/reply resolve the post from the signed-in My Posts profile list and use that card's live xsec detail route.",
        "The opened post detail view is the canonical place to read comments, write a top-level comment, and reply to comments.",
        "The current adapter does not expose the Neo Vlog collection/series field even though a prior manual browser-harness session created and attached a collection."
      ]
    },
    "wechat-channels": {
      "display_name": "WeChat Channels",
      "aliases": ["wechat", "channels"],
      "implementation_status": "code_only_live_ui_unverified",
      "media": {
        "modes": ["video"],
        "video": {"required": true, "formats": ["mp4"], "codec_hint": "H.264", "max_size_gb": 20, "max_duration_hours": 8}
      },
      "fields": {
        "desc": {"cli": "--desc", "required": true, "type": "string", "max_chars": 1000, "implemented": true},
        "title": {"cli": "--title", "required": false, "type": "string", "min_chars": 6, "max_chars": 16, "implemented": true, "meaning": "short title"},
        "tags": {"cli": "--tags", "required": false, "type": "string_list", "implemented": true, "render": "append as #tag"},
        "publish": {"cli": "--publish", "required": false, "type": "boolean", "default": false, "implemented": true},
        "draft": {"cli": "--draft", "required": false, "type": "boolean", "default": true, "implemented": true, "note": "default behavior already saves draft when --publish is absent"},
        "status": {"cli": "status", "required": false, "type": "operation", "implemented": true, "verified": false, "target_fields": ["post_id", "title", "desc"], "values": ["published", "reviewing", "rejected", "draft", "unknown", "not_found"]}
      },
      "capabilities": {
        "draft": true,
        "publish": true,
        "visibility": false,
        "custom_thumbnail": false,
        "post_status": true,
        "update_post": false,
        "read_comments": false,
        "write_comment": false,
        "reply_comments": false
      },
      "content_mapping": {
        "headline": "title",
        "main_text": "desc",
        "discovery_terms": "tags"
      },
      "notes": [
        "The adapter reuses one existing channels.weixin.qq.com tab and creates one only when none exists.",
        "After submit/draft, the adapter inspects the creator manager and returns structured status JSON.",
        "The manager probe is semantic but this implementation run could not verify the live creator UI; unknown/not_found must be treated as authoritative uncertainty.",
        "An uncertain submit is not retried automatically; run status and inspect manager state before any deliberate retry.",
        "Update/edit, comment reading, comments, and replies are intentionally unimplemented until their exact creator UI is observed."
      ]
    },
    "tiktok": {
      "display_name": "TikTok",
      "aliases": [],
      "media": {
        "modes": ["video"],
        "video": {"required": true, "formats": ["mp4"], "max_size_gb": 10, "max_duration_minutes": 10}
      },
      "fields": {
        "caption": {"cli": "--caption", "required": true, "type": "string", "max_chars_including_tags": 4000, "implemented": true},
        "tags": {"cli": "--tags", "required": false, "type": "string_list", "max_count": 10, "implemented": true, "render": "append as #tag"},
        "cover": {"cli": "--cover", "required": false, "type": "file", "implemented": false, "status": "cli_only", "note": "The migrated CLI validates the file but the browser body does not currently apply it."},
        "visibility": {"cli": "--visibility", "required": false, "type": "enum", "values": ["public", "friends", "private"], "default": "public", "implemented": true},
        "allow_comments": {"cli": "--no-comments", "required": false, "type": "boolean", "default": true, "implemented": true},
        "allow_duets": {"cli": "--no-duets", "required": false, "type": "boolean", "default": true, "implemented": true},
        "allow_stitch": {"cli": "--no-stitch", "required": false, "type": "boolean", "default": true, "implemented": true}
      },
      "capabilities": {
        "draft": false,
        "publish": true,
        "visibility": true,
        "custom_thumbnail": false,
        "social_interaction_controls": true,
        "post_status": false,
        "read_comments": false,
        "write_comment": false,
        "reply_comments": false
      },
      "content_mapping": {
        "headline": null,
        "main_text": "caption",
        "discovery_terms": "tags"
      },
      "notes": ["The current adapter performs the final Post action; it has no draft mode."]
    },
    "youtube": {
      "display_name": "YouTube",
      "aliases": ["yt"],
      "media": {
        "modes": ["video"],
        "video": {"required": true}
      },
      "fields": {
        "title": {"cli": "--title", "required": true, "type": "string", "max_chars": 100, "implemented": true},
        "desc": {"cli": "--desc", "required": false, "type": "string", "max_chars": 5000, "implemented": true},
        "tags": {"cli": "--tags", "required": false, "type": "string_list", "max_total_chars": 500, "max_chars_each": 30, "implemented": true},
        "thumbnail": {"cli": "--thumbnail", "required": false, "type": "file", "formats": ["jpg", "png"], "max_size_mb": 2, "implemented": true},
        "visibility": {"cli_group": ["--private", "--unlisted", "--public"], "required": false, "type": "enum", "values": ["PRIVATE", "UNLISTED", "PUBLIC"], "default": "PRIVATE", "implemented": true},
        "made_for_kids": {"cli": "--made-for-kids", "required": false, "type": "boolean", "default": false, "implemented": true}
      },
      "capabilities": {
        "draft": false,
        "publish": true,
        "visibility": true,
        "custom_thumbnail": true,
        "audience_made_for_kids": true,
        "post_status": false,
        "read_comments": false,
        "write_comment": false,
        "reply_comments": false
      },
      "content_mapping": {
        "headline": "title",
        "main_text": "desc",
        "discovery_terms": "tags",
        "visual_packaging": "thumbnail"
      }
    }
  }
}
