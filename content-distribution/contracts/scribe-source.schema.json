{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neo.local/content-distribution/scribe-source.schema.json",
  "title": "Source-bound Video Use Scribe provenance for an existing full-episode transcript",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_sha256",
    "source_path",
    "scribe_sha256",
    "transcription_engine",
    "observed_at"
  ],
  "properties": {
    "schema": {
      "const": "content-distribution.scribe-source.v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute canonical original path returned by check-original-source"
    },
    "scribe_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transcription_engine": {
      "const": "video-use-scribe"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time of actual Scribe completion; do not fabricate"
    },
    "transcription_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Optional verified vendor task identifier"
    }
  }
}
