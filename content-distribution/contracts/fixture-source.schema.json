{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_sha256",
    "transcript_sha256",
    "transcript_path",
    "word_count",
    "method"
  ],
  "properties": {
    "schema": {
      "const": "content-distribution.fixture-source.v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transcript_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transcript_path": {
      "type": "string",
      "minLength": 1
    },
    "word_count": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "const": "synthetic_authored_timed_script"
    }
  }
}
