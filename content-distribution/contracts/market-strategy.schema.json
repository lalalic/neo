{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source-grounded private market experiment matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "source_sha256",
    "variants"
  ],
  "properties": {
    "schema": {
      "const": "content-distribution.market-strategy.v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "variants": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "market",
          "platform",
          "angle",
          "hook",
          "hypothesis",
          "disclosure",
          "scene_ids",
          "publish_state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "angle": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "disclosure": {
            "type": "string",
            "minLength": 1
          },
          "scene_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "publish_state": {
            "enum": [
              "HOLD",
              "ELIGIBLE_PENDING_OWNER_AUTH"
            ]
          }
        }
      }
    }
  }
}
