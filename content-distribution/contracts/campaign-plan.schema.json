{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neo.local/content-distribution/campaign-plan.schema.json",
  "title": "Private Content Distribution Campaign Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "provider_id",
    "rights_evidence_path",
    "target_account_ids",
    "creatives"
  ],
  "properties": {
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "rights_evidence_path": {
      "type": "string",
      "minLength": 1,
      "description": "Private run-relative current licensed-material rights evidence"
    },
    "target_account_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Stable account IDs resolved against project accounts.md; no usernames or links duplicated here"
    },
    "creatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "episode_reference",
          "hook",
          "video_path",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "episode_reference": {
            "type": "string",
            "minLength": 1
          },
          "hook": {
            "type": "string",
            "minLength": 1
          },
          "video_path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "draft",
              "previewed",
              "approved",
              "published"
            ]
          },
          "owner_approval_evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "publication_evidence_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "approved",
                    "published"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "owner_approval_evidence_path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "publication_evidence_path"
              ]
            }
          }
        ]
      }
    },
    "measurement_evidence_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
