{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neo.local/content-distribution/campaign-plan.schema.json",
  "title": "Content distribution private campaign plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "provider_id", "rights_evidence_path", "target_channels", "creatives"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "rights_evidence_path": {"type": "string", "minLength": 1, "description": "Private run-relative current rights evidence path"},
    "target_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "creatives": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "episode_reference", "hook", "video_path", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "episode_reference": {"type": "string", "minLength": 1},
          "hook": {"type": "string", "minLength": 1},
          "video_path": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "draft", "previewed", "approved", "published"]}
        }
      }
    },
    "owner_approval_evidence_path": {"type": "string", "minLength": 1},
    "measurement_evidence_path": {"type": "string", "minLength": 1}
  }
}
