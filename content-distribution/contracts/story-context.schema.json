{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Private Episode Story Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "provider_id", "synopsis", "sources", "characters"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "episode_reference": {"type": "string", "minLength": 1},
    "synopsis": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "url", "observed_at"],
        "properties": {
          "kind": {"enum": ["provider_api", "provider_web", "official_web"]},
          "url": {"type": "string", "pattern": "^https://"},
          "observed_at": {"type": "string", "format": "date-time"},
          "note": {"type": "string"}
        }
      }
    },
    "characters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "relationships": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["to", "type"],
              "properties": {"to": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "speaker_map": {
      "type": "array",
      "description": "Optional legacy speaker evidence only; new speaker guesses go into WebVTT voice labels.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["speaker_id", "character_name", "status", "evidence"],
        "properties": {
          "speaker_id": {"type": "string", "pattern": "^speaker_[0-9]+$"},
          "character_name": {"type": ["string", "null"], "minLength": 1},
          "status": {"enum": ["unresolved", "candidate", "verified"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "start_s", "end_s", "observation"],
              "properties": {
                "kind": {"enum": ["face_lip_sync", "on_screen_name", "subtitle_speaker_tag", "direct_dialogue", "voice_consistency", "human_verification"]},
                "start_s": {"type": "number", "minimum": 0},
                "end_s": {"type": "number", "minimum": 0},
                "observation": {"type": "string", "minLength": 1}
              }
            }
          },
          "note": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "unresolved"}}}, "then": {"properties": {"character_name": {"type": "null"}}}},
          {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"character_name": {"type": "string", "minLength": 1}, "evidence": {"minItems": 2}}}}
        ]
      }
    }
  }
}
